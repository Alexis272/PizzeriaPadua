{
  "name": "pizzeria-padua-desktop",
  "version": "1.0.2",
  "private": true,
  "description": "Panel de gestión de Pizzería Padua para Windows",
  "main": "src/main.js",
  "author": "Pizzería Padua",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "mx.pizzeriapadua.desktop",
    "productName": "Pizzería Padua Gestión",
    "forceCodeSigning": false,
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "Pizzeria-Padua-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Pizzería Padua Gestión",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "Alexis272",
      "repo": "PizzeriaPadua",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
